{
  "name": "@yiaany/ghostapi-hosted-pilot",
  "private": true,
  "type": "module",
  "engines": {
    "bun": "1.3.14",
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun run src/server.ts",
    "dispatcher": "bun run src/dispatcher.ts",
    "cleanup": "bun run src/cleanup.ts",
    "build": "bun build src/server.ts src/dispatcher.ts src/cleanup.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/**/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "auth:migrate": "bunx auth@1.6.26 migrate --config src/auth.ts --yes"
  },
  "dependencies": {
    "@elysiajs/cors": "1.4.2",
    "@upstash/qstash": "2.11.3",
    "@upstash/redis": "1.38.2",
    "better-auth": "1.7.2",
    "elysia": "1.4.29",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "8.21.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
