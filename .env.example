GHOSTAPI_HOST=127.0.0.1
GHOSTAPI_PORT=8080
# GHOSTAPI_DATA_DIR=.ghostapi

# Optional external mock generation. Both settings are required; ambient OPENAI_API_KEY is ignored.
# GHOSTAPI_ALLOW_EXTERNAL_LLM=false
# GHOSTAPI_LLM_API_KEY=

# Required for non-loopback GHOSTAPI_HOST. Use at least 24 random characters and HTTPS or a secure tunnel.
# GHOSTAPI_AUTH_TOKEN=
